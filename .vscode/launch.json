{
    // IntelliSense を使用して利用可能な属性を学べます。
    // 既存の属性の説明をホバーして表示します。
    // 詳細情報は次を確認してください: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "request_for_quote.presentation.fastapi.main:app",
                "--reload",
                "--app-dir",
                "src",
                "--port",
                "8001"
            ],
            "cwd": "${workspaceFolder}/src/",
            "jinja": true
        },
        {
            "name": "Run outbox publisher",
            "type": "debugpy",
            "request": "launch",
            "module": "request_for_quote.presentation.outbox_publisher.main",
            "cwd": "${workspaceFolder}/src/",
        },
        {
            "name": "Run pricing worker",
            "type": "debugpy",
            "request": "launch",
            "module": "request_for_quote.presentation.pricing_worker.main",
            "cwd": "${workspaceFolder}/src/",
        },
    ]
}